<Window x:Class="TwistTidy.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="TwistTidy | Powered by Tweest" Width="1380" Height="920" MinWidth="1050" MinHeight="740" WindowStartupLocation="CenterScreen">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="44"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"><DockPanel Margin="18,28,14,20">
   <StackPanel DockPanel.Dock="Top" Margin="0,0,0,34"><Image Source="{StaticResource Logo}" Width="58" Height="58" HorizontalAlignment="Left"/><TextBlock FontSize="26" FontWeight="Bold" Margin="0,12,0,2"><Run Text="Twist"/><Run Text="Tidy" Foreground="{StaticResource Brand}"/></TextBlock><TextBlock Text="Order, twisted your way." Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="YOUR PRIVATE WORKSPACE" FontSize="10" Foreground="{DynamicResource Muted}" Margin="6,0,0,8"/><TextBlock Text="Local files. Local history.&#x0a;Always in your control." FontSize="12" Foreground="{DynamicResource Muted}" Margin="6,0,0,0"/></StackPanel>
   <StackPanel x:Name="Navigation" IsEnabled="{Binding Ready}">
    <Button Content="⌂    Overview" Tag="Home" Click="Navigate" HorizontalContentAlignment="Left"/>
    <Button Content="▱    Footage Sorter" Tag="Sorter" Click="Navigate"/>
    <Button Content="◈    Duplicate Finder" Tag="Duplicates" Click="Navigate"/>
    <Button Content="⊞    Project Builder" Tag="Builder" Click="Navigate"/>
    <Border Height="1" Background="{DynamicResource Line}" Margin="0,20,8,20"/>
    <Button Content="↶    History and Undo" Tag="History" Click="Navigate"/>
    <Button Content="⚙    Settings" Tag="Settings" Click="Navigate"/>
    <Button Content="ⓘ    About" Tag="About" Click="Navigate"/>
   </StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="34,28,34,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,20"><TextBlock x:Name="Eyebrow" Text="A LITTLE ORDER. A LOT MORE ROOM TO CREATE." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="PageTitle" Text="Your next project starts here." FontSize="32" FontWeight="SemiBold" Margin="0,8,0,6"/><TextBlock x:Name="Subtitle" Text="Give every file a place, and keep every decision yours." Foreground="{DynamicResource Muted}"/></StackPanel>
   <ContentControl x:Name="Page" Grid.Row="1"/>
   <StackPanel Grid.Row="2" Margin="0,12,0,0"><ProgressBar x:Name="Progress" Visibility="Collapsed" IsIndeterminate="True"/><DockPanel Margin="0,8,0,0"><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Click="Cancel" Visibility="Collapsed"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/></DockPanel></StackPanel>
  </Grid>
  <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><DockPanel Margin="24,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Fill="#53D6A1" Width="6" Height="6" Margin="0,0,7,0"/><TextBlock Text="OFFLINE" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Powered by Tweest" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></DockPanel></Border>
 </Grid>
</Window>
